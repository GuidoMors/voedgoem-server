{
  "name": "voedgoem-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "words": "node scripts/build-words.mjs",
    "pretypecheck": "node scripts/build-words.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/build-words.mjs",
    "build": "wrangler deploy --dry-run",
    "predeploy": "node scripts/build-words.mjs",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply voedgoem --local",
    "db:migrate:remote": "wrangler d1 migrations apply voedgoem --remote",
    "admin:grant": "node scripts/set-admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.151.3"
  }
}
