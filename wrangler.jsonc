{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voedgoem-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voedgoem",
      "database_id": "3cb5624f-9d48-4a02-942a-f97ae2bf9627",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
  "vars": {
    "CORS_ORIGINS": "https://voedgoem.guidomors.workers.dev"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
